package miniStackly;

import java.time.LocalDate;
import java.util.ArrayList;
import java.util.HashMap;
import java.util.Map;
import java.util.Scanner;
import java.util.stream.Collectors;
public class PersonalExpenseTracker {

    // enum is used to define a fixed set of constants
    enum Category {
        FOOD,
        TRAVEL,
        SHOPPING,
        BILLS,
        ENTERTAINMENT,
        HEALTH,
        EDUCATION,
        OTHER
    }


    
     // This is an inner class used to represent one expense.
    static class Expense {

        
        private int id;
        private String description;
        private double amount;
        private Category category;
        private LocalDate date;

        // this constructor initializes all the properties of an expense.
        public Expense(int id, String description, double amount,
                       Category category, LocalDate date) {

            this.id = id;
            this.description = description;
            this.amount = amount;
            this.category = category;
            this.date = date;
        }
         // Private variables cannot be accessed directly from outside the class so we use getter method to get variables.
       
        public int getId() {
            return id;
        }
        public String getDescription() {
            return description;
        }
        public double getAmount() {
            return amount;
        }

        public Category getCategory() {
            return category;
        }
        
        public LocalDate getDate() {
            return date;
        }


        
        @Override
        public String toString() {                            // override and expense object..

            return "ID: " + id +
                    " | Description: " + description +
                    " | Amount: ₹" + amount +
                    " | Category: " + category +
                    " | Date: " + date;
        }
    }


    static ArrayList<Expense> expenses = new ArrayList<>();   // it stores all the expenses.


    static Scanner scanner = new Scanner(System.in);


   
    static int nextId = 1;    // initiate the id from 1.....


   
    public static void main(String[] args) {

        
        int choice;


        do {
            System.out.println("\n==================================");
            System.out.println("     PERSONAL EXPENSE TRACKER");
            System.out.println("==================================");

            System.out.println("1. Add Expense");
            System.out.println("2. Categorize Expense");
            System.out.println("3. Delete Expense");
            System.out.println("4. Display All Expenses");
            System.out.println("5. Calculate Total Expense");
            System.out.println("6. Find Highest Expense");
            System.out.println("7. Calculate Category-wise Expenses");
            System.out.println("8. Exit");

            System.out.println("==================================");

            System.out.print("Enter your choice: ");

            choice = scanner.nextInt();
            scanner.nextLine();


            switch (choice) {
                case 1:
                    addExpense();
                    break;
                case 2:
                    categorizeExpense();
                    break;
                case 3:
                    deleteExpense();
                    break;
                case 4:
                    displayExpenses();
                    break;
                case 5:
                    calculateTotalExpense();
                    break;
                case 6:
                    findHighestExpense();
                    break;
                case 7:
                    calculateCategoryWiseExpenses();
                    break;
                case 8:
                    System.out.println("Thank you for using Personal Expense Tracker!");
                    break;
                    
                default:
                    System.out.println(
                            "Invalid choice! Please enter 1-8."
                    );
            }
            
        } while (choice != 8);

        scanner.close();
    }
    
    
    


    
    public static void addExpense() {         // method for add expense.

        System.out.println("\n--- Add Expense ---");
        
        System.out.print("Enter description: ");
        String description = scanner.nextLine();


        
        System.out.print("Enter amount: ₹");
        double amount = scanner.nextDouble();

        scanner.nextLine();


        
         // Call selectCategory() to ask the user to choose an expense category.
        
        Category category = selectCategory();


        LocalDate date = LocalDate.now();


        
        Expense expense = new Expense(      // create a new object and store in expense object..
                nextId++,
                description,
                amount,
                category,
                date
        );

        expenses.add(expense);
        System.out.println("Expense added successfully!");
    }


    
    public static void categorizeExpense() {   // this method used to categorize the expenses.
    	
    	
        if (expenses.isEmpty()) {

            System.out.println("No expenses available.");

            // return stops the method immediately.
            return;
        }


        System.out.println("\n--- Categorize Expense ---");


        // Display all existing expenses...
        displayExpenses();


        
        System.out.print("Enter Expense ID: ");

        int id = scanner.nextInt();

        Expense expense = findExpenseById(id);         // it is a user defined method.... to search the expense by id.

        if (expense != null) {


            Category newCategory = selectCategory();


            Expense updatedExpense = new Expense(       // Create a new Expense object
                    expense.getId(),
                    expense.getDescription(),
                    expense.getAmount(),
                    newCategory,
                    expense.getDate()
            );

            int index = expenses.indexOf(expense);

            expenses.set(index, updatedExpense);   // replace the old expense.


            System.out.println(
                    "Expense category updated successfully!"
            );


        } else {

            System.out.println("Expense ID not found.");
        }
    }

    public static void deleteExpense() {
        if (expenses.isEmpty()) {

            System.out.println("No expenses available.");
            return;
        }


        System.out.println("\n--- Delete Expense ---");


        displayExpenses();    // it displays all the expenses to the user.....
        System.out.print("Enter Expense ID to delete: ");
        int id = scanner.nextInt();


        boolean removed = expenses.removeIf(
                expense -> expense.getId() == id
        );

        if (removed) {  //  if removed = true.

            System.out.println("Expense deleted successfully!");

        } else {
            System.out.println("Expense ID not found.");
        }
    }
    
    

    public static void displayExpenses() {

        System.out.println("\n--- All Expenses ---");

        if (expenses.isEmpty()) {
            System.out.println("No expenses recorded.");
            return;
        }
        System.out.println("------------------------------------------------------------------------------------------");

        System.out.printf(
                "%-5s %-25s %-12s %-18s %-12s%n",
                "ID",
                "Description",
                "Amount",
                "Category",
                "Date"
        );

        System.out.println("------------------------------------------------------------------------------------------");
        for (Expense expense : expenses) {

            System.out.printf(
                    "%-5d %-25s ₹%-11.2f %-18s %-12s%n",
                    expense.getId(),
                    expense.getDescription(),
                    expense.getAmount(),
                    expense.getCategory(),
                    expense.getDate()
            );
        }

        System.out.println("------------------------------------------------------------------------------------------");
    }



    public static void calculateTotalExpense() {


        
        if (expenses.isEmpty()) {

            System.out.println("No expenses available.");
            return;
        }


        double total = expenses.stream()     // Stream is used to process the elements in an array lists.
                .mapToDouble(Expense::getAmount)   // extract the amount from ever expense.
                .sum();


       
        System.out.println("\nTotal Expense: ₹" + total);
    }


   
    public static void findHighestExpense() {

    		if (expenses.isEmpty()) {

            System.out.println("No expenses available.");
            return;
        }
        Expense highestExpense = expenses.stream()
                .max((e1, e2) ->
                        Double.compare(e1.getAmount(), e2.getAmount()))
                .orElse(null);


        System.out.println("\n--- Highest Expense ---");

        System.out.println(highestExpense);
    }

    public static void calculateCategoryWiseExpenses() {
    		if (expenses.isEmpty()) {

            System.out.println("No expenses available.");
            return;
        }

        HashMap<Category, Double> categoryMap = expenses.stream()
                .collect(Collectors.groupingBy(                //group expenses according to their category.
                        Expense::getCategory,   
                        HashMap::new,
                        Collectors.summingDouble(Expense::getAmount)   // add all amount by category..
                ));


        System.out.println("\n--- Category-wise Expenses ---");

        	for (Map.Entry<Category, Double> entry : categoryMap.entrySet()) {     //* Map.Entry represents one key-value pair from the HashMap.         

        		System.out.println(entry.getKey() + " : ₹" + entry.getValue()
            );
        }
    }

    public static Category selectCategory() {
    		System.out.println("\nSelect Category:");
    		System.out.println("1. Food");
        System.out.println("2. Travel");
        System.out.println("3. Shopping");
        System.out.println("4. Bills");
        System.out.println("5. Entertainment");
        System.out.println("6. Health");
        System.out.println("7. Education");
        System.out.println("8. Other");

        System.out.print("Enter category choice: ");
        int choice = scanner.nextInt();
        scanner.nextLine();

        switch (choice) {

            case 1:
                return Category.FOOD;
            case 2:
                return Category.TRAVEL;
                // Choice 3 means SHOPPING.
            case 3:
                return Category.SHOPPING;
            case 4:
                return Category.BILLS;
            case 5:
                return Category.ENTERTAINMENT;   
            case 6:
                return Category.HEALTH;
            case 7:
                return Category.EDUCATION;
            case 8:
                return Category.OTHER;
            default:
                System.out.println("Invalid category. Using OTHER.");

                return Category.OTHER;
        }
    }


    public static Expense findExpenseById(int id) {               
    			return expenses.stream()
                .filter(expense -> expense.getId() == id)
                .findFirst()
                .orElse(null);
    }
}
